<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Dev shim (XAMPP subfolder): serve static files that live in public/
    RewriteCond $1 !.php$
    RewriteCond %{DOCUMENT_ROOT}/atompay/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ---------------------------------------------------------------- performance
# Compress text responses (HTML, CSS, JS, JSON, SVG, XML).
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Vite-built assets carry a content hash in the filename, so they can be cached forever.
<IfModule mod_expires.c>
    ExpiresActive On
    <FilesMatch "\.(css|js|woff2|woff|ttf)$">
        ExpiresDefault "access plus 1 year"
    </FilesMatch>
    <FilesMatch "\.(svg|png|jpe?g|webp|ico)$">
        ExpiresDefault "access plus 30 days"
    </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|woff|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Fonts are preloaded cross-origin; allow it when assets sit on a CDN/other host.
    <FilesMatch "\.(woff2|woff|ttf)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

# ------------------------------------------------------------------ security
# This file only applies in the XAMPP subfolder layout, where the project root
# itself is reachable over HTTP. Production serves public/ directly and never
# loads this. Without these rules, http://localhost/atompay/.env is readable.
<IfModule mod_authz_core.c>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
    <FilesMatch "\.(bak|backup|conf|config|dist|inc|ini|log|old|orig|save|sh|sql|swp|swo|tar|tmp|yml|yaml|lock|md|json)$">
        Require all denied
    </FilesMatch>
</IfModule>

# The framework directories are not web content; none of them should answer.
<IfModule mod_alias.c>
    RedirectMatch 404 ^/atompay/(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$)
</IfModule>

<IfModule mod_headers.c>
    # PHP appends this after Laravel has finished, so the middleware cannot
    # remove it - only the web server can. Production also wants expose_php=Off.
    Header unset X-Powered-By
</IfModule>
