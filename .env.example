APP_NAME=AtomPay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/atompay
ASSET_URL=http://localhost/atompay/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=atomshop
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=null

# Session cookie hardening. Both must be true in production: SECURE_COOKIE
# stops the cookie travelling over plain HTTP, ENCRYPT keeps the session file
# unreadable to anything else sharing the server. Left false here so the
# local XAMPP site (plain http) still signs in.
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email: password-reset codes, "password changed", welcome and alert emails.
# `log` writes every email (and the code in it) to storage/logs/laravel.log -
# right for local, wrong for production. In production use AtomShop's SMTP
# settings so both sites send from the same domain.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AtomShop storefront this instalment service belongs to
ATOMSHOP_URL=https://atomshop.pk
ATOMPAY_ASSET_URL=http://localhost/atomshop

# Shared KYC document store. AtomShop's admin panel must point at this exact
# same directory (its own ATOMPAY_KYC_ROOT) so both apps see one copy of every
# CNIC scan and selfie. Keep it outside both project folders in production so a
# redeploy can never delete an identity document. Leave unset locally to use
# this app's storage/app/private.
# ATOMPAY_KYC_ROOT=/var/www/shared/atompay

# Google Analytics 4 measurement id (public - it appears in page source).
# Empty = no tracking tag and no Google hosts in the CSP. Local/staging hits
# are sent in debug mode (GA > Admin > DebugView), production hits normally.
GOOGLE_ANALYTICS_ID=G-PB9VT5QFML

# --- WhatsApp (password-reset codes only) ---------------------------------
# AtomShop's WhatsApp Cloud API number and its approved `auth_otp` template.
# Copy the token and phone number id from AtomShop's WhatsApp settings. Never
# commit them. Unset: locally the code is written to the log; in production
# the mobile-number option is switched off and only email codes work.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v19.0
# WHATSAPP_OTP_TEMPLATE=auth_otp
# WHATSAPP_OTP_LANGUAGE=en_US

# Mobile-only sign-ups get "<03XXXXXXXXX>@<this domain>" as their AtomShop email
# (the column is required). AtomPay never mails it. Use a domain you own that
# has no mailbox, so anything sent there bounces.
# ATOMPAY_PLACEHOLDER_EMAIL_DOMAIN=no-email.atompay.shop

# --- Mobile app (routes/api.php, docs/api/) --------------------------------
# Firebase service-account JSON for push. Keep it outside the web root and out
# of git. Unset = no push (the in-app notification inbox still works).
# FCM_CREDENTIALS=/var/www/shared/atompay/firebase-service-account.json
# Oldest app build still allowed to run; older builds are asked to update.
# ATOMPAY_APP_MIN_ANDROID=1.0.0
# ATOMPAY_APP_MIN_IOS=1.0.0
# ATOMPAY_APP_STORE_ANDROID=https://play.google.com/store/apps/details?id=...
# ATOMPAY_APP_STORE_IOS=https://apps.apple.com/app/id...
# ATOMPAY_SUPPORT_PHONE=
# ATOMPAY_SUPPORT_WHATSAPP=
# ATOMPAY_SUPPORT_EMAIL=

# --- Security (see config/security.php and docs/security.md) ---------------
# Content-Security-Policy. Switch REPORT_ONLY on while changing the policy:
# the browser then logs violations to the console instead of breaking the page.
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
# SECURITY_CSP_REPORT_URI=

# HSTS is only ever sent in production over HTTPS, so this is safe to leave on.
SECURITY_HSTS_ENABLED=true

# Proxies whose X-Forwarded-* headers may be believed. Empty = trust nothing,
# which is right when Apache serves the site directly. Behind Cloudflare or a
# load balancer set the proxy addresses, or '*' if the app is only reachable
# through it - rate limiting and HTTPS detection both depend on this.
# TRUSTED_PROXIES=
